{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Organiser",
  "version": "0.1.0",
  "identifier": "com.gcoulby.memoryorganiser",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memory Organiser",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyRjc2OUQyNTI5RDAxQzcKUldUSEFaMVMwbW4zZ20xS0R0VERlNlhmMm4yWWJIcDZOOVdQQVlEd0s3V3BOUVBNYUJ5S1EyemwK",
      "endpoints": [
        "https://github.com/gcoulby/claude-memory-organiser/releases/latest/download/latest.json"
      ]
    }
  }
}
